case'hatch':{c.save();c.beginPath();if(s.b.t==='circle')c.arc(X(s.b.c),Y(s.b.c),s.b.r*T.s,0,TP);else s.b.p.forEach((q,i)=>i?c.lineTo(X(q),Y(q)):c.moveTo(X(q),Y(q)));c.clip();const e=bb(s.b),hh=e.y1-e.y0;c.beginPath();for(let v=e.x0-hh;v<=e.x1;v+=s.sp){c.moveTo(X({x:v}),Y({y:e.y0}));c.lineTo(X({x:v+hh}),Y({y:e.y1}))}c.stroke();c.restore();return}}c.stroke()}
const gs=()=>{if(S.gs>0&&S.gs*V.s>=3)return S.gs;let g=10;while(g*V.s<10)g*=5;return g};
function grid(W,H){const g=gs();cx.lineWidth=1;const x0=Math.floor(-V.x/V.s/g),x1=Math.ceil((W-V.x)/V.s/g),y0=Math.floor(-(H-V.y)/V.s/g),y1=Math.ceil(V.y/V.s/g);
