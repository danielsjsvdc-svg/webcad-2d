function sheet(c,pm,ox,oy){const[pw,ph]=SZ[S.lay.size],L=S.lay,X=v=>ox+v*pm,Y=v=>oy+v*pm,tb=30;c.fillStyle='#fff';c.fillRect(X(0),Y(0),pw*pm,ph*pm);c.strokeStyle='#000';c.lineWidth=Math.max(1,.5*pm);c.strokeRect(X(20),Y(10),(pw-30)*pm,(ph-20)*pm);
