function offs(s,n,p){if(s.t==='line'){const L=d(s.a,s.b),u={x:-(s.b.y-s.a.y)/L,y:(s.b.x-s.a.x)/L},g=((p.x-s.a.x)*u.x+(p.y-s.a.y)*u.y)>=0?n:-n,v={x:u.x*g,y:u.y*g};return{...s,a:{x:s.a.x+v.x,y:s.a.y+v.y},b:{x:s.b.x+v.x,y:s.b.y+v.y}}}
const r=d(p,s.c)>s.r?s.r+n:s.r-n;return r>0?{...s,r}:null}
/* drawing */
function dimDraw(c,s,T){const g=dg(s),X=q=>q.x*T.s+T.x,Y=q=>-q.y*T.s+T.y,e=(g.o>=0?1:-1)*s.k*1.25,t=s.k*.75,sg=(p,q)=>{c.moveTo(X(p),Y(p));c.lineTo(X(q),Y(q))},{u,n,A,B}=g;
c.beginPath();sg(s.a,{x:A.x+n.x*e,y:A.y+n.y*e});sg(s.b,{x:B.x+n.x*e,y:B.y+n.y*e});sg(A,B);
[A,B].forEach(P=>sg({x:P.x-(u.x+n.x)*t,y:P.y-(u.y+n.y)*t},{x:P.x+(u.x+n.x)*t,y:P.y+(u.y+n.y)*t}));c.stroke();
let a=Math.atan2(u.y,u.x);if(Math.abs(a)>Math.PI/2)a+=Math.PI;const m=mid(A,B);c.save();c.translate(X(m),Y(m));c.rotate(-a);c.font=2.5*s.k*T.s+'px Arial';c.textAlign='center';c.fillText(Math.round(g.L),0,-s.k*.7*T.s);c.restore()}
function path(c,s,T){const X=q=>q.x*T.s+T.x,Y=q=>-q.y*T.s+T.y;c.beginPath();
switch(s.t){case'line':c.moveTo(X(s.a),Y(s.a));c.lineTo(X(s.b),Y(s.b));break;
case'pl':s.p.forEach((q,i)=>i?c.lineTo(X(q),Y(q)):c.moveTo(X(q),Y(q)));if(s.cl)c.closePath();break;
case'circle':c.arc(X(s.c),Y(s.c),s.r*T.s,0,TP);break;case'arc':c.arc(X(s.c),Y(s.c),s.r*T.s,-s.a0,-s.a1,true);break;
