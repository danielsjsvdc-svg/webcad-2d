case'CIRCLE':a=[{t:'circle',c:l,r:d(l,p)}];break;case'RECTANG':case'ZOOM':a=[rect(l,p)];break;
case'ARC':a=P.length===1?[{t:'line',a:l,b:p}]:[arc3(P[0],P[1],p)].filter(Boolean);break;
case'DIM':a=P.length===1?[{t:'line',a:l,b:p}]:[{t:'dim',a:P[0],b:P[1],o:p,k:S.ann}];break;
