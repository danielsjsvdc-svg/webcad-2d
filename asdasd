let V={x:60,y:400,s:.1},mode='model',un=[],re=[],tool=null,sel=new Set(),cur={x:0,y:0},raw=cur,pan=null,box=null,last='',fl={grid:1,snap:0,ortho:0,os:1};
const log=t=>{const h=$('#hist');h.insertAdjacentHTML('beforeend','<div>'+String(t).replace(/</g,'&lt;')+'</div>');while(h.children.length>4)h.firstChild.remove()};
const save0=()=>{try{localStorage.setItem('webcad',JSON.stringify(S))}catch(e){}};
const push=()=>{un.push(JSON.stringify(S.sh));re=[];if(un.length>100)un.shift();save0()};
const undo=()=>{if(un.length){re.push(JSON.stringify(S.sh));S.sh=JSON.parse(un.pop());sel.clear();upd()}};
const redo=()=>{if(re.length){un.push(JSON.stringify(S.sh));S.sh=JSON.parse(re.pop());sel.clear();upd()}};
const add=s=>{push();s.l=S.cl;if(s.t==='dim')s.k=S.ann;S.sh.push(s)};
/* geometry */
const ap=(s,a)=>({x:s.c.x+s.r*Math.cos(a),y:s.c.y+s.r*Math.sin(a)}),wd=s=>((s.a1-s.a0)%TP+TP)%TP;
function dg(s){const L=d(s.a,s.b)||1,u={x:(s.b.x-s.a.x)/L,y:(s.b.y-s.a.y)/L},n={x:-u.y,y:u.x},o=(s.o.x-s.a.x)*n.x+(s.o.y-s.a.y)*n.y;return{L,u,n,o,A:{x:s.a.x+n.x*o,y:s.a.y+n.y*o},B:{x:s.b.x+n.x*o,y:s.b.y+n.y*o}}}
function kp(s){switch(s.t){case'line':return[s.a,s.b,mid(s.a,s.b)];case'pl':{const r=[...s.p];for(let i=0;i<s.p.length-(s.cl?0:1);i++)r.push(mid(s.p[i],s.p[(i+1)%s.p.length]));return r}
case'circle':return[s.c,{x:s.c.x+s.r,y:s.c.y},{x:s.c.x-s.r,y:s.c.y},{x:s.c.x,y:s.c.y+s.r},{x:s.c.x,y:s.c.y-s.r}];
case'arc':return[s.c,ap(s,s.a0),ap(s,s.a1),ap(s,s.a0+wd(s)/2)];case'text':return[s.p];case'dim':return[s.a,s.b];case'hatch':return kp(s.b)}return[]}
function ds(p,a,b){const dx=b.x-a.x,dy=b.y-a.y,l=dx*dx+dy*dy;let t=l?((p.x-a.x)*dx+(p.y-a.y)*dy)/l:0;t=Math.max(0,Math.min(1,t));return Math.hypot(p.x-a.x-t*dx,p.y-a.y-t*dy)}
function dist(p,s){switch(s.t){case'line':return ds(p,s.a,s.b);
case'pl':{let m=1e18;for(let i=0;i<s.p.length-(s.cl?0:1);i++)m=Math.min(m,ds(p,s.p[i],s.p[(i+1)%s.p.length]));return m}
case'circle':return Math.abs(d(p,s.c)-s.r);
case'arc':{const q=((ang(s.c,p)-s.a0)%TP+TP)%TP;return q<=wd(s)?Math.abs(d(p,s.c)-s.r):Math.min(d(p,ap(s,s.a0)),d(p,ap(s,s.a1)))}
case'text':return p.x>=s.p.x&&p.x<=s.p.x+s.tx.length*s.h*.6&&p.y>=s.p.y&&p.y<=s.p.y+s.h?0:1e18;
case'dim':{const g=dg(s);return Math.min(ds(p,g.A,g.B),ds(p,s.a,g.A),ds(p,s.b,g.B))}case'hatch':return dist(p,s.b)}return 1e18}
const hitAt=w=>{for(let i=S.sh.length-1;i>=0;i--)if(dist(w,S.sh[i])<8/V.s&&!(S.ly[S.sh[i].l]||{}).off)return i;return -1};
function bb(s){const k=kp(s);let x0=1e18,y0=1e18,x1=-1e18,y1=-1e18;k.forEach(q=>{x0=Math.min(x0,q.x);x1=Math.max(x1,q.x);y0=Math.min(y0,q.y);y1=Math.max(y1,q.y)});if(s.r){x0=Math.min(x0,s.c.x-s.r);x1=Math.max(x1,s.c.x+s.r);y0=Math.min(y0,s.c.y-s.r);y1=Math.max(y1,s.c.y+s.r)}return{x0,y0,x1,y1}}
function ext(){let r={x0:1e18,y0:1e18,x1:-1e18,y1:-1e18};S.sh.forEach(s=>{const b=bb(s);r={x0:Math.min(r.x0,b.x0),y0:Math.min(r.y0,b.y0),x1:Math.max(r.x1,b.x1),y1:Math.max(r.y1,b.y1)}});return r.x0>r.x1?{x0:0,y0:0,x1:1e4,y1:7e3}:r}
const rect=(a,b)=>({t:'pl',p:[a,{x:b.x,y:a.y},b,{x:a.x,y:b.y}],cl:1});
function arc3(a,b,c){const D=2*(a.x*(b.y-c.y)+b.x*(c.y-a.y)+c.x*(a.y-b.y));if(Math.abs(D)<1e-9)return null;const q=p=>p.x*p.x+p.y*p.y,o={x:(q(a)*(b.y-c.y)+q(b)*(c.y-a.y)+q(c)*(a.y-b.y))/D,y:(q(a)*(c.x-b.x)+q(b)*(a.x-c.x)+q(c)*(b.x-a.x))/D},ccw=(b.x-a.x)*(c.y-b.y)-(b.y-a.y)*(c.x-b.x)>0;return{t:'arc',c:o,r:d(o,a),a0:ang(o,ccw?a:c),a1:ang(o,ccw?c:a)}}
/* transforms */
const trf=(dx,dy)=>({p:q=>({x:q.x+dx,y:q.y+dy})});
const rotf=(c,a)=>({rot:a,p:q=>{const x=q.x-c.x,y=q.y-c.y,co=Math.cos(a),si=Math.sin(a);return{x:c.x+x*co-y*si,y:c.y+x*si+y*co}}});
const scf=(c,k)=>({sc:k,p:q=>({x:c.x+(q.x-c.x)*k,y:c.y+(q.y-c.y)*k})});
const mirf=(a,b)=>{const t=ang(a,b),co=Math.cos(t),si=Math.sin(t);return{mir:t,p:q=>{const x=q.x-a.x,y=q.y-a.y,pr=x*co+y*si;return{x:a.x+2*pr*co-x,y:a.y+2*pr*si-y}}}};
function xf(s,f){if(s.t==='hatch')return{...s,b:xf(s.b,f)};const o=JSON.parse(JSON.stringify(s));['a','b','o','c'].forEach(k=>{if(o[k])o[k]=f.p(o[k])});if(o.p)o.p=Array.isArray(o.p)?o.p.map(f.p):f.p(o.p);
if(f.sc){if(o.r)o.r*=f.sc;if(o.h)o.h*=f.sc;if(o.k)o.k*=f.sc}
