<script>
(()=>{
const $=s=>document.querySelector(s),TP=Math.PI*2,cv=$('#cv'),cx=cv.getContext('2d');
const d=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y),ang=(a,b)=>Math.atan2(b.y-a.y,b.x-a.x),mid=(a,b)=>({x:(a.x+b.x)/2,y:(a.y+b.y)/2});
const PAL=['#ff5d5d','#ffb347','#c58cff','#ff7ad9','#7ae0ff'],SZ={A5:[210,148],A4:[297,210],A3:[420,297],A2:[594,420],A1:[841,594],A0:[1189,841],'2A0':[1682,1189],'4A0':[2378,1682],B5:[250,176],B4:[353,250],B3:[500,353],B2:[707,500],B1:[1000,707],B0:[1414,1000],Letter:[279,216],Legal:[356,216],'Tabloid 11x17':[432,279],'ANSI C':[559,432],'ANSI D':[864,559],'ANSI E':[1118,864],'ARCH A':[305,229],'ARCH B':[457,305],'ARCH C':[610,457],'ARCH D':[914,610],'ARCH E1':[1067,762],'ARCH E':[1219,914]},STD=[1,2,5,10,20,25,50,75,100,125,150,200,250,500,1000,2000,5000];
